# Copy this file to .env. Never commit real API keys.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
PORT=3000
# Optional path to a TTF font with Vietnamese glyphs for PDF export:
PDF_FONT_PATH=
# On a host with a persistent disk, point DATA_DIR to that disk:
DATA_DIR=./data
